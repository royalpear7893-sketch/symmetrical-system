function GetNearestPlayerToPoint(origin)
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (root.Position - origin).Magnitude
                if dist < bestDist then best, bestDist = p, dist end
            end
        end
    end
    return best
end

function GetNearestToCrosshair(camera)
    local best, bestScore = nil, math.huge
    local camPos = camera.CFrame.Position
    local camLook = camera.CFrame.LookVector
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local dir = (root.Position - camPos).Unit
                local dot = camLook:Dot(dir)
                if dot > 0 then
                    local score = 1 - dot
                    if score < bestScore then best, bestScore = p, score end
                end
            end
        end
    end
    return best
end

function PickAimTarget()
    if AimTargetMode == "MANUAL" and AimManualTarget then
        if AimManualTarget.Character then
            local hum = AimManualTarget.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then return AimManualTarget end
        end
        return nil
    end
    if AimPriority == "Nearest Player" then
        return GetNearestPlayerToPoint(Camera.CFrame.Position)
    else
        return GetNearestToCrosshair(Camera)
    end
end

function GetAimPart(character)
    if AimTargetPart == "Head" then
        return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    else
        return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
    end
end

RunService.RenderStepped:Connect(function(dt)
    SilentCircle.Visible = AimActive and AimModeSilent
    if SilentCircle.Visible then
        SilentCircle.Size = UDim2.fromOffset(AimFOVSize * 2, AimFOVSize * 2)
        SilentCircle.Position = UDim2.new(0.5, -AimFOVSize, 0.5, -AimFOVSize)
    end

    if not AimActive then
        AimStatus.Text = "● AIMBOT OFF"
        AimStatus.TextColor3 = C.Gray
        AimLockedPlayer = nil
        return
    end

    local target = PickAimTarget()
    if not target or not target.Character then
        AimStatus.Text = "● SEARCHING..."
        AimStatus.TextColor3 = C.Cyan
        AimLockedPlayer = nil
        return
    end

    local root = target.Character:FindFirstChild("HumanoidRootPart")
    local aimPart = GetAimPart(target.Character)
    if not root or not aimPart then
        AimStatus.Text = "● SEARCHING..."
        AimStatus.TextColor3 = C.Cyan
        AimLockedPlayer = nil
        return
    end

    if AimModeSilent then
        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
        if not onScreen then
            AimStatus.Text = "● SEARCHING (OFF SCREEN)"
            AimStatus.TextColor3 = C.Cyan
            AimLockedPlayer = nil
            return
        end
        local vp = Camera.ViewportSize
        local centerX, centerY = vp.X / 2, vp.Y / 2
        local dx = screenPos.X - centerX
        local dy = screenPos.Y - centerY
        if math.sqrt(dx * dx + dy * dy) > AimFOVSize then
            AimStatus.Text = "● SEARCHING (OUT OF CIRCLE)"
            AimStatus.TextColor3 = C.Cyan
            AimLockedPlayer = nil
            return
        end
    end

    AimLockedPlayer = target
    AimStatus.Text = "● LOCKED: " .. target.Name
    AimStatus.TextColor3 = C.Green

    local doCamera = AimModeSilent or AimModeCamera
    local doCharacter = AimModeSilent or AimModeCharacter

    if doCamera then
        local targetCF = CFrame.new(Camera.CFrame.Position, aimPart.Position)
        Camera.CFrame = Camera.CFrame:Lerp(targetCF, 1)
    end

    if doCharacter then
        local myChar = Player.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myRoot then
            local lookCF = CFrame.lookAt(myRoot.Position, aimPart.Position)
            myRoot.CFrame = CFrame.new(myRoot.Position) * (lookCF - lookCF.Position)
        end
    end
end)

