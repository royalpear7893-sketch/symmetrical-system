AttachAlignPos = nil
AttachAlignOri = nil
AttachAttachment = nil

function SetNoclip(state)
    local char = Player.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
end

function DestroyAttachConstraints()
    if AttachAlignPos then pcall(function() AttachAlignPos:Destroy() end) AttachAlignPos = nil end
    if AttachAlignOri then pcall(function() AttachAlignOri:Destroy() end) AttachAlignOri = nil end
    if AttachAttachment then pcall(function() AttachAttachment:Destroy() end) AttachAttachment = nil end
end

function RebuildAttachConstraints()
    DestroyAttachConstraints()
    if not AttachActive then return end

    local myChar = Player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    AttachAttachment = Instance.new("Attachment")
    AttachAttachment.Name = "PERFECT_ATTACH_ATT"
    AttachAttachment.Parent = myRoot

    AttachAlignPos = Instance.new("AlignPosition")
    AttachAlignPos.Name = "PERFECT_ATTACH_POS"
    AttachAlignPos.Attachment0 = AttachAttachment
    AttachAlignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
    AttachAlignPos.Responsiveness = 100
    AttachAlignPos.MaxForce = 100000
    AttachAlignPos.ApplyAtCenterOfMass = true
    AttachAlignPos.Position = myRoot.Position
    AttachAlignPos.Parent = myRoot

    AttachAlignOri = Instance.new("AlignOrientation")
    AttachAlignOri.Name = "PERFECT_ATTACH_ORI"
    AttachAlignOri.Attachment0 = AttachAttachment
    AttachAlignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
    AttachAlignOri.Responsiveness = 100
    AttachAlignOri.MaxTorque = 100000
    AttachAlignOri.CFrame = myRoot.CFrame
    AttachAlignOri.Parent = myRoot
end

RunService.RenderStepped:Connect(function()
    if not AttachActive then return end
    if not AttachTarget then
        AttachStatus.Text = "● NO TARGET SELECTED"
        AttachStatus.TextColor3 = C.Cyan
        DestroyAttachConstraints()
        return
    end

    local targetChar = AttachTarget.Character
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")

    if not targetChar then
        AttachStatus.Text = "● TARGET LEFT"
        AttachStatus.TextColor3 = C.Red
        DestroyAttachConstraints()
        return
    end

    if not targetHum or targetHum.Health <= 0 then
        AttachStatus.Text = "● TARGET DEAD"
        AttachStatus.TextColor3 = C.Red
        DestroyAttachConstraints()
        return
    end

    if not targetRoot then
        AttachStatus.Text = "● TARGET INVALID"
        AttachStatus.TextColor3 = C.Red
        return
    end

    if not AttachAlignPos or not AttachAlignPos.Parent then
        RebuildAttachConstraints()
    end

    local targetCFrame = targetRoot.CFrame
    local behindPos = targetCFrame.Position - (targetCFrame.LookVector * AttachDistance) + Vector3.new(0, AttachHeight, 0)
    local faceCFrame = CFrame.lookAt(behindPos, targetRoot.Position)

    if AttachAlignPos then AttachAlignPos.Position = behindPos end
    if AttachAlignOri then AttachAlignOri.CFrame = faceCFrame end

    AttachStatus.Text = "● ATTACHED: " .. AttachTarget.Name
    AttachStatus.TextColor3 = C.Green
end)

