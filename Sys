function FOVFromPosition(xPosition)
    local trackWidth = FOVTrack.AbsoluteSize.X
    if trackWidth <= 0 then return end
    local relative = math.clamp(xPosition / trackWidth, 0, 1)
    UpdateFOV(math.floor(FOV_MIN + (FOV_MAX - FOV_MIN) * relative + 0.5))
    local knobPos = relative * trackWidth
    FOVKnob.Position = UDim2.new(0, knobPos - 9, 0.5, -9)
    FOVKnobGlow.Position = UDim2.new(0, knobPos - 13, 0.5, -13)
    FOVFill.Size = UDim2.new(relative, 0, 1, 0)
end

