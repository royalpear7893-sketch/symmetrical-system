TransTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        transDragging = true
        transFromPosition(input.Position.X - TransTrack.AbsolutePosition.X)
        Animate(TransKnobGlow, { BackgroundTransparency = 0.6 }, 0.15)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        transDragging = false
        Animate(TransKnobGlow, { BackgroundTransparency = 0.75 }, 0.2)
    end
end)
UIS.InputChanged:Connect(function(input)
    if transDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        transFromPosition(input.Position.X - TransTrack.AbsolutePosition.X)
    end
end)
