TRANS_MIN = 0
TRANS_MAX = 80

function updateTransparency(value)
    CurrentTransparency = value
    TransValueLabel.Text = tostring(value)
    if Main then
        Main.BackgroundTransparency = 0.04 + (value / 100) * 0.76
    end
end

function transFromPosition(xPosition)
    local trackWidth = TransTrack.AbsoluteSize.X
    if trackWidth <= 0 then return end
    local relative = math.clamp(xPosition / trackWidth, 0, 1)
    local value = math.floor(TRANS_MIN + (TRANS_MAX - TRANS_MIN) * relative + 0.5)
    updateTransparency(value)
    local knobPos = relative * trackWidth
    TransKnob.Position = UDim2.new(0, knobPos - 9, 0.5, -9)
    TransKnobGlow.Position = UDim2.new(0, knobPos - 13, 0.5, -13)
    TransFill.Size = UDim2.new(relative, 0, 1, 0)
end

