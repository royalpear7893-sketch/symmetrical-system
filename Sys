function MakePremiumSelector(parent, yPos, title, onSelect)
    local Card = Create("Frame", {
        Size = UDim2.new(1, -12, 0, 240),
        Position = UDim2.new(0, 6, 0, yPos),
        BackgroundColor3 = C.Card,
        BackgroundTransparency = 0.06,
        BorderSizePixel = 0
    }, parent)
    Round(Card, 12)
    Outline(Card, C.Blue, 1, 0.4)

    Create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.fromOffset(12, 6),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = C.Cyan,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Card)

    local SearchBox = Create("TextBox", {
        Size = UDim2.new(1, -24, 0, 30),
        Position = UDim2.new(0, 12, 0, 32),
        BackgroundColor3 = C.Background,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        Text = "",
        PlaceholderText = "Search players...",
        PlaceholderColor3 = C.Gray,
        TextColor3 = C.White,
        TextSize = 10,
        Font = Enum.Font.Gotham,
        ClearTextOnFocus = false
    }, Card)
    Round(SearchBox, 8)
    Outline(SearchBox, C.Blue, 1, 0.45)

    local Scroll = Create("ScrollingFrame", {
        Size = UDim2.new(1, -24, 0, 150),
        Position = UDim2.new(0, 12, 0, 72),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = C.Cyan
    }, Card)

    Create("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, Scroll)

    local SelectedPlayer = nil
    local rows = {}

    local function RefreshList()
        for _, child in ipairs(Scroll:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        rows = {}
        local query = string.lower(SearchBox.Text)

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= Player and string.find(string.lower(p.Name), query, 1, true) then
                local row = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundColor3 = C.Background,
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Text = ""
                }, Scroll)
                Round(row, 8)
                local stroke = Outline(row, C.Blue, 1, 0.6)

                local avatar = Create("ImageLabel", {
                    Size = UDim2.fromOffset(28, 28),
                    Position = UDim2.new(0, 6, 0.5, -14),
                    BackgroundColor3 = C.Card,
                    Image = "",
                    BorderSizePixel = 0
                }, row)
                Round(avatar, 14)

                task.spawn(function()
                    local success, img = pcall(function()
                        return Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                    end)
                    if success and avatar.Parent then
                        avatar.Image = img
                    end
                end)

                local nameLbl = Create("TextLabel", {
                    Size = UDim2.new(1, -50, 0, 14),
                    Position = UDim2.fromOffset(42, 6),
                    BackgroundTransparency = 1,
                    Text = p.Name,
                    TextColor3 = C.White,
                    Font = Enum.Font.GothamBold,
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, row)

                local hpLbl = Create("TextLabel", {
                    Size = UDim2.new(1, -50, 0, 12),
                    Position = UDim2.fromOffset(42, 22),
                    BackgroundTransparency = 1,
                    Text = "HP: --",
                    TextColor3 = C.Gray,
                    Font = Enum.Font.Gotham,
                    TextSize = 8,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, row)

                task.spawn(function()
                    while row.Parent do
                        local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                        if hum then
                            hpLbl.Text = "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
                            hpLbl.TextColor3 = hum.Health > 0 and C.Green or C.Red
                        else
                            hpLbl.Text = "HP: DEAD"
                            hpLbl.TextColor3 = C.Red
                        end
                        task.wait(0.5)
                    end
                end)

                row.MouseButton1Click:Connect(function()
                    SelectedPlayer = p
                    for _, r in ipairs(Scroll:GetChildren()) do
                        if r:IsA("TextButton") then
                            r.BackgroundColor3 = C.Background
                            local s = r:FindFirstChildOfClass("UIStroke")
                            if s then s.Transparency = 0.6 end
                        end
                    end
                    row.BackgroundColor3 = C.Selected
                    stroke.Transparency = 0.15
                    onSelect(p)
                end)
            end
        end
    end

    SearchBox:GetPropertyChangedSignal("Text"):Connect(RefreshList)
    RefreshList()
    Players.PlayerAdded:Connect(RefreshList)
    Players.PlayerRemoving:Connect(RefreshList)

    return Card, Scroll, SearchBox
end

